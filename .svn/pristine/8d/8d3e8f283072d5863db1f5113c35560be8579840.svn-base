	public static void main(String args[])
	{
		try
		{
			Display display = Display.getDefault();
			frmEvidencijaRacuna shell = new frmEvidencijaRacuna(null);
			shell.open();
			shell.layout();
			while (!shell.isDisposed())
			{
				if (!display.readAndDispatch())
				{
					display.sleep();
				}
			}
		} catch (Exception e)
		{
			e.printStackTrace();
		}
	}

