	@Override
	protected void checkSubclass()
	{
		// Disable the check that prevents subclassing of SWT components
	}

	protected void createContents()
	{
		setText("Evidencija ra\u010Duna");
		setSize(450, 385);
		txtNaziv.setText(racun.getNaziv());
		SimpleDateFormat smf = new SimpleDateFormat();
		// txtDatumIzdavanja.setText(smf.format(racun.getDatum()));
		txtIznosZaPlatit.setText(racun.getIznosZaPlatiti());
		DateFormat dateFormat = new SimpleDateFormat("dd/MM/yyyy");
		Calendar cal = Calendar.getInstance();
		txtDatumIzdavanja.setText(dateFormat.format(racun.getDatum()));
		lblDatumEvidentiranja.setText(dateFormat.format(cal.getTime()).toString());
		lblEvidentiranje.setText(lblEvidentiranje.getText() + " " + "[" + " " + racun.getNaziv() + " " + "]");
	}

	protected void do_btnOdustani_widgetSelected(SelectionEvent arg0)
	{
		this.close();
	}

	protected void do_btnSnimi_widgetSelected(SelectionEvent arg0)
	{

		String string = txtKolicina.getText();
		char[] chars = new char[string.length()];
		string.getChars(0, chars.length, chars, 0);
		for (int i = 0; i < chars.length; i++)
		{
			if (!('0' <= chars[i] && chars[i] <= '9'))
			{
				MessageDialog.openError(null, "Greška", "U polje količina se mogu unijeti samo brojčane vrijednosti!");
				return;
			}
		}
		if (txtKolicina.getText() == "" || cmbLijekovi.getText() == "" || cmbUsluge.getText() == "")
		{
			MessageDialog.openError(null, "Greška", "Sva polja su obavezna za unos!");
			return;
		}
		KupljeniLijekovi k = new KupljeniLijekovi();
		IzvrseneUsluge u = new IzvrseneUsluge();
		Integer Kol = Integer.parseInt(txtKolicina.getText());
		k.setKolicina(Kol);
		k.setLijekovi(cmbLijekovi.uzmiOznacenuStavku(Lijekovi.class));
		k.setRacuni(racun);
		u.setRacuni(racun);
		u.setUsluge(cmbUsluge.uzmiOznacenuStavku(Usluge.class));
		servis.Dodavanje.EvidencijaRacuna(k, u);
		MessageDialog.openInformation(null, "Informacija", "Račun uspješno evidentiran!");
		OcistiPolja();
		ucitajComboLijekovi();
		ucitajComboUsluge();
	}

	public String IntToString(Integer kolicina)
	{
		return kolicina.toString();
	}

	private void OcistiPolja()
	{
		txtKolicina.setText("");
		cmbLijekovi.removeAll();
		cmbUsluge.removeAll();
	}

	private void ucitajComboLijekovi()
	{
		List<Lijekovi> lista = DAO.getAll(Lijekovi.class);
		for (Lijekovi l : lista)
		{
			cmbLijekovi.dodajStavku(l, l.getNaziv());
		}
	}

	private void ucitajComboUsluge()
	{
		List<Usluge> lista2 = DAO.getAll(Usluge.class);
		for (Usluge u : lista2)
		{
			cmbUsluge.dodajStavku(u, u.getNaziv());
		}
	}
}
