		lblDatumIzdavanja.setBounds(10, 42, 97, 15);
		lblDatumIzdavanja.setText("Datum izdavanja:");

		txtDatumIzdavanja = new Text(composite, SWT.BORDER | SWT.READ_ONLY);
		txtDatumIzdavanja.setBounds(118, 36, 113, 21);

		Label lblifraRauna = new Label(composite, SWT.NONE);
		lblifraRauna.setBackground(SWTResourceManager.getColor(SWT.COLOR_INFO_BACKGROUND));
		lblifraRauna.setBounds(10, 77, 79, 15);
		lblifraRauna.setText("Iznos za platit:");

		txtIznosZaPlatit = new Text(composite, SWT.BORDER | SWT.READ_ONLY);
