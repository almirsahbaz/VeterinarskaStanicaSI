package ui;

import helper.DAO;
import helper.MojComboBox;

import java.util.List;

import model.Vlasnik;

import org.eclipse.jface.dialogs.MessageDialog;
import org.eclipse.jface.fieldassist.ControlDecoration;
import org.eclipse.swt.SWT;
import org.eclipse.swt.events.SelectionAdapter;
import org.eclipse.swt.events.SelectionEvent;
import org.eclipse.swt.widgets.Button;
import org.eclipse.swt.widgets.Display;
import org.eclipse.swt.widgets.Label;
import org.eclipse.swt.widgets.Shell;
import org.eclipse.wb.swt.SWTResourceManager;

public class frmObrisiVlasnika extends Shell
{

	/**
	 * Launch the application.
	 * 
	 * @param args
	 */
	public static void main(String args[])
	{
		try
		{
			Display display = Display.getDefault();
			frmObrisiVlasnika shell = new frmObrisiVlasnika(display);
			shell.open();
			shell.layout();
			while (!shell.isDisposed())
			{
				if (!display.readAndDispatch())
				{
					display.sleep();
				}
			}
		} catch (Exception e)
		{
			e.printStackTrace();
		}
	}

	/**
	 * Create the shell.
	 * 
	 * @param display
	 */
	private final MojComboBox cmbVlasnik;

	public frmObrisiVlasnika(Display display)
	{
		super(display, SWT.CLOSE | SWT.MIN | SWT.MAX | SWT.TITLE);
		setImage(SWTResourceManager.getImage(frmObrisiVlasnika.class, "/ui/slike/1389302842_edit-delete.png"));
		setLayout(null);

		Label lblVlasnik = new Label(this, SWT.NONE);
		lblVlasnik.setBounds(10, 84, 55, 15);
		lblVlasnik.setText("Vlasnik :");

		cmbVlasnik = new MojComboBox(this, SWT.READ_ONLY);
		cmbVlasnik.setBounds(82, 81, 196, 23);

		Button btnObrii = new Button(this, SWT.NONE);
		btnObrii.addSelectionListener(new SelectionAdapter()
		{
			@Override
			public void widgetSelected(SelectionEvent arg0)
			{
				Vlasnik v = cmbVlasnik.uzmiOznacenuStavku(Vlasnik.class);
				if (cmbVlasnik.getText() == "")
				{
					MessageDialog.openError(null, "Greška", "Morate odabrati vlasnika kojeg želite obrisati");
					return;
				}
				DAO.brisi(v);
				MessageDialog.openInformation(null, "Informacija", "Vlasnik usjpešno obrisan!");
				close();
			}
		});
		btnObrii.setBounds(82, 123, 85, 25);
		btnObrii.setText("Obri\u0161i");

		Button btnOdustani = new Button(this, SWT.NONE);
		btnOdustani.setBounds(193, 123, 85, 25);
		btnOdustani.addSelectionListener(new SelectionAdapter()
		{
			@Override
			public void widgetSelected(SelectionEvent arg0)
			{
				close();
			}
		});
		btnOdustani.setText("Odustani");

		Label lblBrisanjeVlasnika = new Label(this, SWT.SHADOW_NONE);
		lblBrisanjeVlasnika.setImage(SWTResourceManager.getImage(frmObrisiVlasnika.class, "/ui/slike/delete72.png"));
		lblBrisanjeVlasnika.setBounds(49, 24, 229, 25);
		lblBrisanjeVlasnika.setFont(SWTResourceManager.getFont("Arial", 14, SWT.BOLD));
		lblBrisanjeVlasnika.setAlignment(SWT.RIGHT);
		lblBrisanjeVlasnika.setText("BRISANJE VLASNIKA");

		ControlDecoration controlDecoration = new ControlDecoration(lblBrisanjeVlasnika, SWT.LEFT | SWT.TOP);
		controlDecoration.setImage(SWTResourceManager.getImage(frmObrisiVlasnika.class, "/ui/slike/1389302842_edit-delete.png"));
		controlDecoration.setDescriptionText("Some description");
		createContents();
		List<Vlasnik> lista = DAO.getAll(Vlasnik.class);
		for (Vlasnik v : lista)
		{
			cmbVlasnik.dodajStavku(v, (v.getIme() + " " + v.getPrezime()));
		}
	}

	@Override
	protected void checkSubclass()
	{
		// Disable the check that prevents subclassing of SWT components
	}

	/**
	 * Create contents of the shell.
	 */
	protected void createContents()
	{
		setText("Brisanje vlasnika");
		setSize(298, 200);

	}
}
