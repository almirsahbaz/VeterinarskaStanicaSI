	/**
	 * Launch the application.
	 * 
	 * @param args
	 */
	public static void otvori()
	{
		try
		{
			Display display = Display.getDefault();
			frmGlavnaAdministrator shell = new frmGlavnaAdministrator(display);
			shell.open();
			shell.layout();
			while (!shell.isDisposed())
			{
				if (!display.readAndDispatch())
				{
					display.sleep();
				}
			}
		} catch (Exception e)
		{
			e.printStackTrace();
		}
	}

