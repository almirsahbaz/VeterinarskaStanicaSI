package model;

import java.util.Date;

import javax.persistence.Entity;
import javax.persistence.GeneratedValue;
import javax.persistence.Id;
import javax.persistence.JoinColumn;
import javax.persistence.ManyToOne;

@Entity
public class Racuni
{

	@Id
	@GeneratedValue
	private int racunID;

	private String naziv;
	private Date datum;

	private String iznosZaPlatiti;

	@JoinColumn(nullable = false)
	@ManyToOne
	public Tehnicko_osoblje tehnicko_osoblje;

	public Date getDatum()
	{
		return datum;
	}

	public String getIznosZaPlatiti()
	{
		return iznosZaPlatiti;
	}

	public String getNaziv()
	{
		return naziv;
	}

	public int getRacunID()
	{
		return racunID;
	}

	public Tehnicko_osoblje getTehnicko_osoblje()
	{
		return tehnicko_osoblje;
	}

	public void setDatum(Date datum)
	{
		this.datum = datum;
	}

	public void setIznosZaPlatiti(String iznosZaPlatiti)
	{
		this.iznosZaPlatiti = iznosZaPlatiti;
	}

	public void setNaziv(String naziv)
	{
		this.naziv = naziv;
	}

	public void setRacunID(int racunID)
	{
		this.racunID = racunID;
	}

	public void setTehnicko_osoblje(Tehnicko_osoblje tehnicko_osoblje)
	{
		this.tehnicko_osoblje = tehnicko_osoblje;
	}

}